APP_ENV=development
SCREENPLAY_SCORING_MODE=mock
PORT=3000

FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:3000

LLM_PROVIDER=mock
MOCK_LLM_SCENARIO=successful_pilot
DRY_RUN=true
ALLOW_MOCK_IN_PRODUCTION=false

TURNSTILE_MODE=mock
ALLOW_MOCK_TURNSTILE_IN_PRODUCTION=false
VITE_TURNSTILE_MODE=mock

ABUSE_STORE=memory
CACHE_STORE=memory
RESULT_STORE=memory

RAW_PDF_PERSISTENCE_ENABLED=false
RAW_TEXT_PERSISTENCE_ENABLED=false
REDACT_TITLE_PAGE_PII=true

ANONYMOUS_SESSION_SECRET=local-development-session-secret-change-me
CSRF_SECRET=local-development-csrf-secret-change-me
UPLOAD_TOKEN_SECRET=local-development-upload-secret-change-me
RESULT_TOKEN_SECRET=local-development-result-secret-change-me
DELETION_TOKEN_SECRET=local-development-deletion-secret-change-me
IP_HMAC_SECRET=local-development-ip-secret-change-me
DEVICE_ID_HMAC_SECRET=local-development-device-secret-change-me

UPLOAD_TOKEN_TTL_SECONDS=300
ANONYMOUS_SESSION_TTL_SECONDS=604800

TARGET_COST_PER_SCRIPT_USD=0.10
DEVELOPMENT_LLM_SPEND_LIMIT_USD=5.00

OPENAI_API_KEY=

# Disabled by default. Never use a browser-exposed VITE_ variable for these values.
FRAMER_CMS_SYNC_ENABLED=false
FRAMER_CMS_PUBLISH_MODE=draft
FRAMER_API_TOKEN=
FRAMER_PROJECT_ID=
FRAMER_COLLECTION_ID=
