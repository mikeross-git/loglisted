APP_ENV=staging
SCREENPLAY_SCORING_MODE=mock
NODE_ENV=production
HOST=0.0.0.0
PORT=10000

# Exact origins only. Replace the placeholder with the published Framer origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://MY-FRAMER-SITE.framer.website

MOCK_LLM_SCENARIO=successful_pilot
DRY_RUN=true

# "test" uses Cloudflare's published always-pass test credentials and local
# server-side validation. Use "managed" with a staging-only widget secret for
# meaningful public bot protection.
TURNSTILE_MODE=test
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAMES=MY-FRAMER-SITE.framer.website
TURNSTILE_EXPECTED_ACTION=screenplay_upload

# Generate independent random values of at least 32 characters. Never reuse
# production secrets.
SESSION_SIGNING_SECRET=replace-with-an-independent-staging-secret-01
DEVICE_HMAC_SECRET=replace-with-an-independent-staging-secret-02
CSRF_SIGNING_SECRET=replace-with-an-independent-staging-secret-03
IP_HMAC_SECRET=replace-with-an-independent-staging-secret-04
RESULT_TOKEN_SIGNING_SECRET=replace-with-an-independent-staging-secret-05
DELETION_TOKEN_SIGNING_SECRET=replace-with-an-independent-staging-secret-06
UPLOAD_TOKEN_SIGNING_SECRET=replace-with-an-independent-staging-secret-07

ANONYMOUS_SESSION_TTL_SECONDS=604800
UPLOAD_TOKEN_TTL_SECONDS=300
RESULT_TTL_SECONDS=86400
ABUSE_TELEMETRY_TTL_SECONDS=604800
GLOBAL_ANALYSES_PER_MINUTE=10
MAX_COMPLETED_PER_SESSION=10
MAX_COMPLETED_PER_IP=20
AUTHORIZATION_ATTEMPTS_PER_10_MINUTES=10
ANALYSIS_ATTEMPTS_PER_10_MINUTES=10

MAX_PDF_BYTES=15728640
MAX_PDF_PAGES=150
MIN_READABLE_TEXT_LENGTH=1000
PDF_LOW_TEXT_PAGE_THRESHOLD=40

RAW_PDF_PERSISTENCE_ENABLED=false
RAW_TEXT_PERSISTENCE_ENABLED=false
STORAGE_DRIVER=memory
TRUST_PROXY_HOPS=1

# Optional backend-only CMS synchronization. Mock records default to drafts.
FRAMER_CMS_SYNC_ENABLED=false
FRAMER_CMS_PUBLISH_MODE=draft
FRAMER_API_TOKEN=
FRAMER_PROJECT_ID=
FRAMER_COLLECTION_ID=

# OPENAI_API_KEY is intentionally absent. The staging executable never imports
# or constructs the OpenAI adapter.
